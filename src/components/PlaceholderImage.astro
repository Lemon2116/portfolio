---
interface Props {
	label?: string;
	ratio?: string;
}

const { label = 'Replace with project image', ratio = '4 / 3' } = Astro.props;
---

<div class="placeholder-image" style={`aspect-ratio: ${ratio};`}>
	<span>{label}</span>
</div>

<style>
	.placeholder-image {
		width: 100%;
		border-radius: 2px;
		background: linear-gradient(135deg, #f4e9d6, #efe2c8);
		border: 1px dashed rgba(28, 26, 23, 0.25);
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 1rem;
	}

	.placeholder-image span {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}
</style>
